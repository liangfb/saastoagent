# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_mesh

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET_KEY=your-jwt-secret-change-in-production

# Langfuse (Cloud). Get keys from your Langfuse project settings.
# US region: https://us.cloud.langfuse.com  |  EU region: https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# mem0 (Agent Memory)
MEM0_BASE_URL=http://localhost:8080

# LLM Provider API Keys (configure as needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# AWS Bedrock (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# CORS: empty = allow ALL origins. Set a comma-separated allowlist of your
# frontend origin(s) to lock it down in production.
CORS_ORIGINS=

# Server
PORT=8000
NODE_ENV=development
