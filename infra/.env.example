# Infra deploy configuration — COPY to infra/.env and fill in your values.
#
# Sourced by infra/scripts/deploy-k8s.sh and deploy-test-env.sh.
# The real infra/.env is gitignored; only this .example is tracked.

# AWS region of your EKS cluster + ECR registry.
AWS_REGION=us-west-2

# EKS cluster name (used by `aws eks update-kubeconfig`).
EKS_CLUSTER_NAME=my-cluster

# Kubernetes namespace the app is deployed into.
K8S_NAMESPACE=agentic-mesh

# AWS account ID that owns the ECR registry. Leave empty to auto-detect via
# `aws sts get-caller-identity`.
AWS_ACCOUNT_ID=

# Note: the RDS/PostgreSQL endpoint is NOT consumed by these scripts. Put the
# full connection string in infra/k8s/02-secrets.yaml → DATABASE_URL.