# All 5 mock-erp services use the same Docker image,
# differentiated by SERVICE_NAME and SERVICE_PORT env vars.
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mock-erp-sales
  namespace: agentic-mesh
  labels:
    app: mock-erp-sales
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mock-erp-sales
  template:
    metadata:
      labels:
        app: mock-erp-sales
    spec:
      containers:
        - name: mock-erp-sales
          image: ACCOUNT_ID.dkr.ecr.us-west-2.amazonaws.com/agentic-mesh/mock-erp:latest
          ports:
            - containerPort: 9001
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: 200m
              memory: 256Mi
          env:
            - name: SERVICE_NAME
              value: "sales_order"
            - name: SERVICE_PORT
              value: "9001"
---
apiVersion: v1
kind: Service
metadata:
  name: mock-erp-sales
  namespace: agentic-mesh
spec:
  selector:
    app: mock-erp-sales
  ports:
    - port: 9001
      targetPort: 9001
---
