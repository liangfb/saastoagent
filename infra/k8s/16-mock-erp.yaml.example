---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mock-erp-finance
  namespace: agentic-mesh
  labels:
    app: mock-erp-finance
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mock-erp-finance
  template:
    metadata:
      labels:
        app: mock-erp-finance
    spec:
      containers:
        - name: mock-erp-finance
          image: ACCOUNT_ID.dkr.ecr.us-west-2.amazonaws.com/agentic-mesh/mock-erp:latest
          ports:
            - containerPort: 9005
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: 200m
              memory: 256Mi
          env:
            - name: SERVICE_NAME
              value: "finance"
            - name: SERVICE_PORT
              value: "9005"
            # API key the finance service requires on its data endpoints
            # (header: X-API-Key). Mock value for the test env; replace with a
            # real secret in production.
            - name: FINANCE_API_KEY
              value: "mock-finance-key-7f3a9c2e"
---
apiVersion: v1
kind: Service
metadata:
  name: mock-erp-finance
  namespace: agentic-mesh
spec:
  selector:
    app: mock-erp-finance
  ports:
    - port: 9005
      targetPort: 9005
