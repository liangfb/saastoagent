apiVersion: apps/v1
kind: Deployment
metadata:
  name: mem0
  namespace: agentic-mesh
  labels:
    app: mem0
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mem0
  template:
    metadata:
      labels:
        app: mem0
    spec:
      containers:
        - name: mem0
          image: ACCOUNT_ID.dkr.ecr.us-west-2.amazonaws.com/agentic-mesh/mem0-server:latest
          ports:
            - containerPort: 8080
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
          env:
            - name: MEM0_VECTOR_STORE__PROVIDER
              value: "opensearch"
            - name: MEM0_VECTOR_STORE__CONFIG__HOST
              value: "OPENSEARCH_HOST"
            - name: MEM0_VECTOR_STORE__CONFIG__PORT
              value: "443"
            - name: MEM0_VECTOR_STORE__CONFIG__USER
              value: "admin"
            - name: MEM0_VECTOR_STORE__CONFIG__PASSWORD
              valueFrom:
                secretKeyRef:
                  name: opensearch-secrets
                  key: OPENSEARCH_PASSWORD
            - name: MEM0_VECTOR_STORE__CONFIG__COLLECTION_NAME
              value: "agent_memories"
            - name: MEM0_VECTOR_STORE__CONFIG__EMBEDDING_MODEL_DIMS
              value: "1024"
            - name: MEM0_LLM__PROVIDER
              value: "aws_bedrock"
            - name: MEM0_LLM__CONFIG__MODEL
              value: "global.anthropic.claude-sonnet-4-6"
            - name: MEM0_LLM__CONFIG__AWS_REGION
              value: "us-west-2"
            - name: MEM0_EMBEDDER__PROVIDER
              value: "aws_bedrock"
            - name: MEM0_EMBEDDER__CONFIG__MODEL
              value: "amazon.titan-embed-text-v2:0"
            - name: MEM0_EMBEDDER__CONFIG__AWS_REGION
              value: "us-west-2"
            - name: AWS_REGION
              value: "us-west-2"
            - name: AWS_ACCESS_KEY_ID
              valueFrom:
                secretKeyRef:
                  name: app-secrets
                  key: AWS_ACCESS_KEY_ID
            - name: AWS_SECRET_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: app-secrets
                  key: AWS_SECRET_ACCESS_KEY
          livenessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 15
            periodSeconds: 15
          readinessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: mem0
  namespace: agentic-mesh
spec:
  selector:
    app: mem0
  ports:
    - port: 8080
      targetPort: 8080
  type: ClusterIP
