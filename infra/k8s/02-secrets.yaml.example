# Example Secret manifest — COPY to 02-secrets.yaml and fill in real values.
#
# DO NOT commit the populated 02-secrets.yaml (it is gitignored). For real
# deployments prefer a managed secret store (AWS Secrets Manager + External
# Secrets Operator, SOPS, or Sealed Secrets) over a plaintext manifest.
#
# Populate from terraform output:  terraform output -json | jq
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: agentic-mesh
type: Opaque
stringData:
  DATABASE_URL: "postgresql://USER:PASSWORD@RDS_HOST:5432/agentic_mesh"
  REDIS_URL: "redis://REDIS_HOST:6379/0"
  REDIS_HOST: "REDIS_HOST"
  REDIS_PORT: "6379"
  JWT_SECRET_KEY: "CHANGE_ME_min_8_chars_random_secret"
  # Langfuse Cloud keys (https://us.cloud.langfuse.com → project settings)
  LANGFUSE_PUBLIC_KEY: "pk-lf-..."
  LANGFUSE_SECRET_KEY: "sk-lf-..."
  # LLM Provider API keys (set the ones you use)
  ANTHROPIC_API_KEY: ""
  OPENAI_API_KEY: ""
  GOOGLE_API_KEY: ""
  # AWS (for Bedrock + mem0 embeddings); prefer IRSA over static keys in prod
  AWS_ACCESS_KEY_ID: ""
  AWS_SECRET_ACCESS_KEY: ""
  AWS_REGION: ""
  # CORS: empty = allow ALL origins. Set a comma-separated allowlist of your
  # frontend origin(s) to lock it down in production.
  CORS_ORIGINS: ""
---
apiVersion: v1
kind: Secret
metadata:
  name: opensearch-secrets
  namespace: agentic-mesh
type: Opaque
stringData:
  # mem0 vector store — OpenSearch master user password (terraform output
  # opensearch_password). Consumed by infra/k8s/13-mem0.yaml.
  OPENSEARCH_PASSWORD: "CHANGE_ME_strong_password"
